{
  "name": "@kiosk-tv/controller",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --watch dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@kiosk-tv/browser": "workspace:*",
    "@kiosk-tv/provider-hotstar": "workspace:*",
    "@kiosk-tv/provider-kit": "workspace:*",
    "@kiosk-tv/provider-sunnxt": "workspace:*",
    "@kiosk-tv/provider-youtube": "workspace:*",
    "@kiosk-tv/provider-zee5": "workspace:*",
    "@kiosk-tv/shared": "workspace:*",
    "hono": "^4.13.17",
    "serialport": "^13.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
