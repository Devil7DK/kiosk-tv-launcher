{
  "name": "@kiosk-tv/package-deb",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "package": "node src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^24",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "rolldown": "~1.2.18",
    "typescript": "~6.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
